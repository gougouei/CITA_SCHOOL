# ─── Supabase ──────────────────────────────────────────────────────────────────
# Récupérez ces valeurs sur https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service Role Key (côté serveur uniquement — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Jitsi (cours en direct vidéo) ────────────────────────────────────────────
# Domaine Jitsi à utiliser.
#   - "8x8.vc"        → Jitsi as a Service (JaaS) — recommandé en production
#   - "meet.jit.si"   → instance publique gratuite, limitée à 5 min en iframe (démo seulement)
#   - "ton-domaine.tld" → instance self-hosted
NEXT_PUBLIC_JITSI_DOMAIN=8x8.vc

# ─── Jitsi as a Service (JaaS) ────────────────────────────────────────────────
# Récupérez ces valeurs sur https://jaas.8x8.vc/
# Laisser vide si vous utilisez meet.jit.si ou une instance self-hosted sans JWT.
JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JAAS_KID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/xxxxxx
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# AppID exposé côté client (identique à JAAS_APP_ID) — sert à préfixer la room
# et à charger external_api.js depuis https://8x8.vc/{appId}/external_api.js
NEXT_PUBLIC_JAAS_APP_ID=vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
