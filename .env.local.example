# ─── Supabase ──────────────────────────────────────────────────────────────────
# Récupérez ces valeurs sur https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service Role Key (côté serveur uniquement — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Jitsi Meet (cours en direct vidéo) ───────────────────────────────────────
# Par défaut on utilise l'instance publique gratuite meet.jit.si.
# Pour utiliser ta propre instance Jitsi self-hosted, change cette valeur.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
